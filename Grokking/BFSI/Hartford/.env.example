ENV=local

# Mandatory — the orchestrator will exit if this is not present
TARGET_REPO_URL=https://github.com/jaygajera17/E-commerce-project-springBoot

# GCP primary settings (kept minimal)
GCP_PROJECT_ID=
GCP_LOCATION=us-central1

# Optional fallback for non-GCP developer machines
GOOGLE_API_KEY=
GEMINI_MODEL=

# Redis
REDIS_URL=redis://localhost:6379/0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# LLM runtime controls (tune as you like)
MAX_METHODS_PER_RUN=30
MAX_LLM_CALLS=50
LLM_TIMEOUT_S=25
LLM_PARALLELISM=4
DEBUG_LLM=1   # set to 0 to silence the prints