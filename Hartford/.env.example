ENV=local

# Mandatory — the orchestrator will exit if this is not present
TARGET_REPO_URL=https://github.com/jaygajera17/E-commerce-project-springBoot

# GCP / Vertex
GCP_PROJECT_ID=
GCP_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
GEMINI_MODEL=gemini-1.5-flash

# Redis
REDIS_URL=redis://localhost:6379/0

# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
